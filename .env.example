# =============================================================================
# CARBON-AWARE DEEP REINFORCEMENT LEARNING PLATFORM — ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT:
#   - NEVER commit .env to version control
#   - .env.example is safe to commit (contains no real secrets)
#   - All values below are placeholders — replace with your actual values
# =============================================================================


# -----------------------------------------------------------------------------
# WattTime API Credentials (REQUIRED)
# -----------------------------------------------------------------------------
# Get credentials at: https://www.watttime.org/api-documentation/
# These are used by all components that interact with the WattTime API:
#   - daily_update.py (data pipeline)
#   - k8s_controller.py (live scheduling)
#   - infer_shadow.py (shadow mode)
WATTTIME_USERNAME=your_watttime_username_here
WATTTIME_PASSWORD=your_watttime_password_here


# -----------------------------------------------------------------------------
# Region Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of WattTime region codes.
# Must match the regions configured in config/regions.yaml.
# Common US regions:
#   - CAISO_NORTH (California ISO, Northern)
#   - CAISO_SOUTH (California ISO, Southern)
#   - MISO (Midcontinent ISO, Midwest)
#   - ERCOT (Texas)
#   - PJM (Mid-Atlantic)
#   - NYIS (New York)
#   - ISNE (New England)
REGIONS=CAISO_NORTH,MISO,ERCOT


# -----------------------------------------------------------------------------
# Data Pipeline Settings
# -----------------------------------------------------------------------------
# How many days of historical data to download on each update.
# Larger values = more training data, but slower downloads.
LOOKBACK_DAYS=90

# Signal type from WattTime.
# MOER = Marginal Operating Emissions Rate (recommended for schedulers)
# CO2_AVERAGE = Average carbon intensity
SIGNAL_TYPE=MOER

# Cache directory for downloaded Parquet files.
CACHE_DIR=./watttime_cache


# -----------------------------------------------------------------------------
# Training Settings
# -----------------------------------------------------------------------------
# PyTorch device: "cpu", "cuda", "cuda:0", "mps" (Apple Silicon)
DEVICE=cpu

# Training hyperparameters (can also be set via CLI args)
TRAIN_EPISODES=500
TRAIN_LR=3e-4
TRAIN_GAMMA=0.99
WINDOW_SIZE=5


# -----------------------------------------------------------------------------
# Inference Settings
# -----------------------------------------------------------------------------
# Shadow mode: seconds between decisions
SHADOW_INTERVAL_SEC=300

# Shadow mode: max decisions (null = unlimited)
SHADOW_MAX_DECISIONS=


# -----------------------------------------------------------------------------
# Kubernetes Settings (for production deployment)
# -----------------------------------------------------------------------------
# Namespace where the controller runs
K8S_NAMESPACE=carbon-aware

# Kubernetes node names (must align 1:1 with REGIONS above)
# Example: if REGIONS=CAISO_NORTH,MISO,ERCOT, then:
#   K8S_NODE_NAMES=node-caiso,node-miso,node-ercot
K8S_NODE_NAMES=node-caiso,node-miso,node-ercot

# Prometheus URL for node utilization metrics (Kepler)
PROMETHEUS_URL=http://prometheus-operated.monitoring:9090


# -----------------------------------------------------------------------------
# Monitoring & Observability
# -----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log directory
LOG_DIR=./logs

# Enable JSON structured logs (for Datadog/Loki/ELK)
JSON_LOGS=false

# Health check port (for K8s liveness probes)
HEALTH_CHECK_PORT=8080

# Prometheus metrics port
METRICS_PORT=8000


# -----------------------------------------------------------------------------
# Grafana (for docker-compose local dev stack)
# -----------------------------------------------------------------------------
# Default credentials for local Grafana instance.
# CHANGE THESE IN PRODUCTION!
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_in_production


# -----------------------------------------------------------------------------
# Notifications (optional)
# -----------------------------------------------------------------------------
# Slack/Discord webhook URL for update failure notifications.
# Leave empty to disable notifications.
NOTIFICATION_WEBHOOK=


# -----------------------------------------------------------------------------
# Experiment Tracking (optional)
# -----------------------------------------------------------------------------
# Weights & Biases API key (for experiment tracking)
# Get yours at: https://wandb.ai/authorize
WANDB_API_KEY=
WANDB_PROJECT=carbon-aware-swarm
WANDB_ENTITY=


# -----------------------------------------------------------------------------
# Advanced / Experimental
# -----------------------------------------------------------------------------
# Enable forecast-aware baseline (requires WattTime forecast API access)
ENABLE_FORECASTS=false

# Forecast horizon in hours
FORECAST_HORIZON_HOURS=24

# Embodied carbon tracking (experimental)
ENABLE_EMBODIED_CARBON=false